# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ticketdb?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Seat Hold TTL (minutes)
SEAT_HOLD_TTL_MINUTES=10

# Waitlist Offer TTL (minutes)
WAITLIST_OFFER_TTL_MINUTES=15

# Email (Resend — https://resend.com, free tier 3000/month)
# Sign up → API Keys → Create Key → paste here
RESEND_API_KEY=re_your_api_key_here
# From address — use onboarding@resend.dev for testing (no domain setup needed)
# For production with your own domain: "TicketSphere <noreply@yourdomain.com>"
EMAIL_FROM="TicketSphere <onboarding@resend.dev>"
