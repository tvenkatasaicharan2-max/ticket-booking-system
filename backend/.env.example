# Backend
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ticketdb?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Seat Hold TTL (minutes)
SEAT_HOLD_TTL_MINUTES=10

# Waitlist Offer TTL (minutes)
WAITLIST_OFFER_TTL_MINUTES=15

# Email (Brevo — https://brevo.com, free tier 300 emails/day, sends to ANY email worldwide)
# Steps: Sign up → Settings → API Keys → Generate → paste BREVO_API_KEY below
# Then: Senders & IPs → Add a Sender → verify your Gmail address (1-click in Gmail)
BREVO_API_KEY=your_brevo_api_key_here
# The verified sender Gmail address
EMAIL_FROM_ADDRESS=your@gmail.com
